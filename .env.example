# Copy values securely into your hosting settings. Do not commit a real .env.
APP_ENV=production
SECRET_KEY=
LEAD_ENCRYPTION_KEY=
ADMIN_PASSWORD_HASH=
PUBLIC_URL=https://your-domain.example
PRIVACY_EMAIL=
NOTIFY_TO=
NOTIFY_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Persistent volume, never an ephemeral deployment folder:
DATABASE_PATH=/var/data/epoxy/leads.sqlite3
MIN_SQFT=500
RETENTION_DAYS=90
# SERVICE_ZIPS=63101,63102,63103
LEGAL_OPERATOR=
SITE_NAME=STL Floor Match
SITE_REGION=St. Louis, Missouri
# See docs/OPERATIONS.md before trusting any proxy hops.
TRUST_PROXY_HOPS=0
